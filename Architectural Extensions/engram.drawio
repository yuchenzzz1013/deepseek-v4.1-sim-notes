  <diagram name="第 1 页" id="0q2tuasgFeeSlU030lav">
    <mxGraphModel dx="1261" dy="694" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="ttl" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=18;fontStyle=1;fontColor=#222222;" value="Engram: Deterministic N-gram Memory (DeepSeek V4.1 Flash)" vertex="1">
          <mxGeometry height="32" width="1120" x="95" y="40" as="geometry" />
        </mxCell>
        <mxCell id="h_in" parent="1" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#999999;fontSize=12;fontColor=#333333;" value="Input Hidden States h&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#777777&quot;&gt;[B, L, hc_mult, dim]&lt;br&gt;mHC 四流并行残差（各 sublayer 读写 4 条）&lt;/font&gt;" vertex="1">
          <mxGeometry height="70" width="388" x="561" y="860" as="geometry" />
        </mxCell>
        <mxCell id="compressed_id_map" parent="1" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#999999;fontSize=12;fontColor=#333333;" value="Compressed ID Map（Tokenizer 侧）&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#777777&quot;&gt;build_compressed_token_map()&lt;br&gt;启动时从 tokenizer 确定性构建，无可学习参数&lt;br&gt;NFKC/去重音/小写/空白折叠 → 多对一映射&lt;br&gt;compressed vocab = 99,092&lt;/font&gt;" vertex="1">
          <mxGeometry height="70" width="388" x="561" y="769" as="geometry" />
        </mxCell>
        <mxCell id="address" parent="1" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=12;fontColor=#333333;" value="Addressing: N-gram Hash (deterministic)&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#555555&quot;&gt;idx = (compress(t&lt;sub&gt;p-n&lt;/sub&gt;)×mult&lt;sub&gt;n&lt;/sub&gt; XOR ... XOR compress(t&lt;sub&gt;p&lt;/sub&gt;)×mult&lt;sub&gt;0&lt;/sub&gt;) mod bucket_prime&lt;br&gt;per (order, head): disjoint prime ranges&lt;br&gt;[B, L, n_hash_cols]&lt;/font&gt;" vertex="1">
          <mxGeometry height="89" width="388" x="561" y="658" as="geometry" />
        </mxCell>
        <mxCell id="retrieve" parent="1" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=12;fontColor=#333333;" value="Retrieval: gather + concat + wkv&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#555555&quot;&gt;e = concat(M&lt;sub&gt;v&lt;/sub&gt;[idx&lt;sub&gt;1&lt;/sub&gt;], ..., M&lt;sub&gt;v&lt;/sub&gt;[idx&lt;sub&gt;H&lt;/sub&gt;])&lt;br&gt;kv = wkv(e); key, value = split(kv)&lt;br&gt;key = [B,L,hc_mult,dim], value = [B,L,dim]&lt;br&gt;wkv: [24×256] → dim×(hc_mult+1) = [25600]&lt;/font&gt;" vertex="1">
          <mxGeometry height="81" width="388" x="561" y="553.5" as="geometry" />
        </mxCell>
        <mxCell id="gate" parent="1" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#999999;fontSize=12;fontColor=#333333;" value="Gate (normalized dot-product)&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#777777&quot;&gt;gate = σ(copysign(sqrt(clamp_min(|dot|, ε)), dot))&lt;br&gt;dot = Σ&lt;sub&gt;dim&lt;/sub&gt;(h·w·key) · rstd&lt;sub&gt;h&lt;/sub&gt; · rstd&lt;sub&gt;k&lt;/sub&gt; · dim&lt;sup&gt;-0.5&lt;/sup&gt;&lt;br&gt;&lt;b&gt;逐 (token, hc_copy) 独立对 dim 求和，非跨 copy 联合&lt;/b&gt;&lt;br&gt;[B, L, hc_mult]&lt;/font&gt;" vertex="1">
          <mxGeometry height="80" width="388" x="561" y="450" as="geometry" />
        </mxCell>
        <mxCell id="merge" parent="1" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#999999;fontSize=12;fontColor=#333333;" value="Gated Residual Merge&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#777777&quot;&gt;h&#39; = h + gate ⊙ value&lt;br&gt;[B, L, hc_mult, dim]&lt;/font&gt;" vertex="1">
          <mxGeometry height="70" width="388" x="561" y="360" as="geometry" />
        </mxCell>
        <mxCell id="o_proj" parent="1" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#999999;fontSize=12;fontColor=#333333;" value="Output Projection W&lt;sub&gt;o&lt;/sub&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#777777&quot;&gt;[B, L, hc_mult, dim] → [B, L, D]&lt;/font&gt;" vertex="1">
          <mxGeometry height="70" width="388" x="561" y="260" as="geometry" />
        </mxCell>
        <mxCell id="out" parent="1" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#999999;fontSize=12;fontColor=#333333;" value="Injection into Attention&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#777777&quot;&gt;→ Layer 1 (SWA + CSA2)&lt;br&gt;→ Layer 14 (CSA2 Full)&lt;/font&gt;" vertex="1">
          <mxGeometry height="70" width="388" x="561" y="160" as="geometry" />
        </mxCell>
        <mxCell id="mem_k" parent="1" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=12;fontColor=#333333;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;" value="&lt;b&gt;Memory Keys M&lt;sub&gt;k&lt;/sub&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#777777&quot;&gt;learned static lookup table&lt;br&gt;384,006,168 rows per Engram layer&lt;br&gt;256 FP8 values + ue8m0 scales (~264 B/row)&lt;br&gt;read-only at inference&lt;br&gt;两表结构同构；行数差异源于各层独立素数桶 offset 累计&lt;br&gt;合计 ~200 GB / 196B 参数&lt;br&gt;[N&lt;sub&gt;m&lt;/sub&gt;, d&lt;sub&gt;e&lt;/sub&gt;]&lt;/font&gt;" vertex="1">
          <mxGeometry height="140" width="270" x="1061" y="632.5" as="geometry" />
        </mxCell>
        <mxCell id="mem_v" parent="1" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=12;fontColor=#333333;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;" value="&lt;b&gt;Memory Values M&lt;sub&gt;v&lt;/sub&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#777777&quot;&gt;learned static lookup table&lt;br&gt;384,016,682 rows per Engram layer&lt;br&gt;256 FP8 values + ue8m0 scales (~264 B/row)&lt;br&gt;read-only at inference&lt;br&gt;两表结构同构；各层素数桶独立采样导致行数微差&lt;br&gt;合计 ~200 GB / 196B 参数&lt;br&gt;[N&lt;sub&gt;m&lt;/sub&gt;, d&lt;sub&gt;e&lt;/sub&gt;]&lt;/font&gt;" vertex="1">
          <mxGeometry height="140" width="276" x="1060" y="447" as="geometry" />
        </mxCell>
        <mxCell id="rd_t" parent="1" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=11;fontStyle=1;fontColor=#333333;" value="Retrieval 细节" vertex="1">
          <mxGeometry height="36" width="320" x="60" y="213" as="geometry" />
        </mxCell>
        <mxCell id="rd_1" parent="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D79B00;fontSize=10;fontColor=#333333;align=left;spacingLeft=10;verticalAlign=middle;" value="&lt;b&gt;逐桶 gather&lt;/b&gt;：每 (阶, head) 从各自桶范围取 1 行 FP8 嵌入（256 值 + ue8m0 block scales）" vertex="1">
          <mxGeometry height="60" width="320" x="60" y="255" as="geometry" />
        </mxCell>
        <mxCell id="rd_2" parent="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D79B00;fontSize=10;fontColor=#333333;align=left;spacingLeft=10;verticalAlign=middle;" value="&lt;b&gt;拼接 + wkv 投影&lt;/b&gt;：24 行（3 阶 × 8 头）拼接为 e，送入 wkv 线性层 → key [B,L,hc_mult,dim]（每 hc 分支）+ 共享 value [B,L,dim]；一次矩阵乘法同时产生所有分支 key 和一个 value" vertex="1">
          <mxGeometry height="60" width="320" x="60" y="321" as="geometry" />
        </mxCell>
        <mxCell id="rd_3" parent="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D79B00;fontSize=10;fontColor=#333333;align=left;spacingLeft=10;verticalAlign=middle;" value="&lt;b&gt;有界读取&lt;/b&gt;：每 token 每层 24 路独立并行随机访问，24 行 × 264 B ≈ 6.2 KiB；TP=4 下 ≈ 1.55 KiB/GPU；两 Engram 层共 ~12.4 KiB/token，O(1)" vertex="1">
          <mxGeometry height="60" width="320" x="60" y="387" as="geometry" />
        </mxCell>
        <mxCell id="rd_4" parent="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D79B00;fontSize=10;fontColor=#333333;align=left;spacingLeft=10;verticalAlign=middle;" value="&lt;b&gt;跨块前缀复用&lt;/b&gt;：prefix-cache 命中物理块复用，相同 token ID 复用相同哈希槽，检索结果确定" vertex="1">
          <mxGeometry height="60" width="320" x="60" y="453" as="geometry" />
        </mxCell>
        <mxCell id="rd_5" parent="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D79B00;fontSize=10;fontColor=#333333;align=left;spacingLeft=10;verticalAlign=middle;" value="&lt;b&gt;输出&lt;/b&gt;：经 wkv 生成 key/value；无 O(N) 注意力计算、无加权求和，仅查表 + 线性变换" vertex="1">
          <mxGeometry height="60" width="320" x="60" y="519" as="geometry" />
        </mxCell>
        <mxCell id="ad_t" parent="1" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=11;fontStyle=1;fontColor=#333333;" value="Addressing 细节" vertex="1">
          <mxGeometry height="36" width="320" x="60" y="647" as="geometry" />
        </mxCell>
        <mxCell id="ad_1" parent="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D79B00;fontSize=10;fontColor=#333333;align=left;spacingLeft=10;verticalAlign=middle;" value="&lt;b&gt;Tokenizer 压缩&lt;/b&gt;：NFKC / 去重音 / 小写 / 空白折叠 → 多对一映射；压缩词表 = 99,092；&quot;The&quot;/&quot;the&quot;/&quot;THE&quot; 哈希到同一 ID" vertex="1">
          <mxGeometry height="60" width="320" x="60" y="689" as="geometry" />
        </mxCell>
        <mxCell id="ad_2" parent="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D79B00;fontSize=10;fontColor=#333333;align=left;spacingLeft=10;verticalAlign=middle;" value="&lt;b&gt;逐阶 XOR 链哈希&lt;/b&gt;：压缩 ID × per-layer odd multiplier，跨 lookback depth XOR 链式混合；2/3/4-gram，每阶 8 个 hash head（共 24 头）；modulo 各自素数桶大小" vertex="1">
          <mxGeometry height="60" width="320" x="60" y="755" as="geometry" />
        </mxCell>
        <mxCell id="ad_3" parent="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D79B00;fontSize=10;fontColor=#333333;align=left;spacingLeft=10;verticalAlign=middle;" value="&lt;b&gt;素数桶布局&lt;/b&gt;：每 (阶, head) 独占素数大小的桶范围，范围互不相交，避免二次碰撞；桶索引 = XOR 链 mod 桶素数" vertex="1">
          <mxGeometry height="60" width="320" x="60" y="821" as="geometry" />
        </mxCell>
        <mxCell id="ad_4" parent="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D79B00;fontSize=10;fontColor=#333333;align=left;spacingLeft=10;verticalAlign=middle;" value="&lt;b&gt;跨步状态管理&lt;/b&gt;：hash_cache 每 KV slot 一个 int32 缓存压缩 ID；spec-decode 回滚时槽位稳定可复用" vertex="1">
          <mxGeometry height="60" width="320" x="60" y="887" as="geometry" />
        </mxCell>
        <mxCell id="ad_5" parent="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D79B00;fontSize=10;fontColor=#333333;align=left;spacingLeft=10;verticalAlign=middle;" value="&lt;b&gt;输出&lt;/b&gt;：idx = XOR 链哈希 mod 桶素数 → bucket；无需 softmax / query-key 相似度 / 搜索" vertex="1">
          <mxGeometry height="60" width="320" x="60" y="953" as="geometry" />
