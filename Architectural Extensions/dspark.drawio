    <mxGraphModel dx="721" dy="397" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="ttl" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=20;fontStyle=1;fontColor=#1A1A1A;" value="DSpark — Confidence-Scheduled Speculative Decoding" vertex="1">
          <mxGeometry height="36" width="1000" x="80" y="230" as="geometry" />
        </mxCell>
        <mxCell id="in_state" parent="1" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#999999;fontSize=12;fontColor=#333333;shadow=0;strokeWidth=2;" value="Decoding State&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#777777&quot;&gt;anchor token x&lt;sub&gt;0&lt;/sub&gt; + target hidden h&lt;sub&gt;t&lt;/sub&gt;&lt;br&gt;[B, 1, D]&lt;/font&gt;" vertex="1">
          <mxGeometry height="56" width="260" x="400" y="950" as="geometry" />
        </mxCell>
        <mxCell id="draft" parent="1" style="rounded=1;arcSize=15;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=12;fontColor=#333333;shadow=0;strokeWidth=2;" value="Draft Backbone + Markov Head&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#555555&quot;&gt;半自回归 · anchor-first&lt;br&gt;并行主干 + 低秩 Markov 转移偏置（rank=256）&lt;br&gt;从左到右顺序采样，叠加前一个已采样 token 的 bias&lt;br&gt;[B, γ, V]（含锚点；γ=5 配置，草稿 γ-1）&lt;/font&gt;" vertex="1">
          <mxGeometry height="82" width="260" x="400" y="830" as="geometry" />
        </mxCell>
        <mxCell id="conf_head" parent="1" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=12;fontColor=#333333;shadow=0;strokeWidth=2;" value="Confidence Head&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#555555&quot;&gt;条件接受概率 c&lt;sub&gt;k&lt;/sub&gt; = σ(proj([h&lt;sub&gt;k&lt;/sub&gt;; markov_embed&lt;sub&gt;k-1&lt;/sub&gt;]))&lt;br&gt;STS 校准：left-to-right grid search · 基于历史 accept 统计&lt;br&gt;拼接 Markov prev-token embedding（默认开启）&lt;br&gt;[B, γ]&lt;/font&gt;" vertex="1">
          <mxGeometry height="80" width="460" x="300" y="730" as="geometry" />
        </mxCell>
        <mxCell id="sched" parent="1" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=12;fontColor=#333333;shadow=0;strokeWidth=2;" value="Confidence-Scheduled Prefix Scheduler&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#555555&quot;&gt;max Θ = τ · SPS(B)&lt;br&gt;τ = Σ&lt;sub&gt;r&lt;/sub&gt; Π&lt;sub&gt;j≤k&lt;/sub&gt; c&lt;sub&gt;r,j&lt;/sub&gt;（全局存活概率累积）&lt;br&gt;B=全局 top-B 预算 · s.t. L ≤ γ&lt;br&gt;实现 Algorithm 1：smooth-SPS 假设下贪心选择&lt;br&gt;异步：CPU sizing · GPU slot · ZOS（Zero-Overhead Scheduler） · CUDA-graph&lt;/font&gt;" vertex="1">
          <mxGeometry height="110" width="460" x="300" y="588" as="geometry" />
        </mxCell>
        <mxCell id="verif" parent="1" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=12;fontColor=#333333;shadow=0;strokeWidth=2;" value="Target Model Verification (Lossless)&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#555555&quot;&gt;拒绝采样 · 残差 bonus token&lt;br&gt;输出分布严格一致&lt;/font&gt;" vertex="1">
          <mxGeometry height="70" width="460" x="300" y="490" as="geometry" />
        </mxCell>
        <mxCell id="emit" parent="1" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=12;fontColor=#333333;shadow=0;strokeWidth=2;" value="Emit Accepted Tokens&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#777777&quot;&gt;更新 decoding state&lt;br&gt;next step ↺&lt;/font&gt;" vertex="1">
          <mxGeometry height="56" width="260" x="400" y="390" as="geometry" />
        </mxCell>
        <mxCell id="e_in_draft" edge="1" parent="1" source="in_state" style="edgeStyle=orthogonalEdgeStyle;rounded=0;jettySize=0;html=1;strokeWidth=2;endArrow=classic;endFill=1;endSize=7;strokeColor=#1A1A1A;" target="draft">
          <mxGeometry relative="1" as="geometry" />
