        <mxCell id="e_detail_loss" edge="1" parent="1" source="detail_loss" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=1.5;endArrow=open;endFill=0;dashed=1;strokeColor=#6C8EBF;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" target="draft">
